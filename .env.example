# ==============================================================================
# AI Smart Irrigation and Water Conservation — Environment Configuration
# ==============================================================================

# Database Connection:
# Leave blank for local SQLite (persisted at data/smart_irrigation.db).
# In production on Render, set this to your Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CORS Allowed Origins (comma-separated URLs):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# Web Server Port (Defaults to 8000 locally; Render provides $PORT in production):
PORT=8000

# Model and Dataset Storage Paths (Optional overrides):
MODEL_DIR=ml/saved_models
DATASET_PATH=data/sample_sensor_data.csv

